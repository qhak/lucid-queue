{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lucid-queue",
  "workers_dev": true,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lucid-queue",
      "database_id": "c60b487e-a91f-442d-bd5c-d96f44d96180",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    {
      "name": "lucid-job-runner",
      "binding": "JOB_RUNNER",
      "class_name": "JobWorkflow"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://lucid-queue.callout-ai.workers.dev",
    "CUTRANK_PROCESSOR_URL": "https://calloutapp.callout-ai.workers.dev/api/lucid/process",
    "MODHORIZON_PROCESSOR_URL": "https://modhorizon.callout-ai.workers.dev/api/internal/lucid-queue"
  },
  "observability": {
    "enabled": true
  }
}
