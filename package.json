{
  "name": "lucid-queue",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler d1 migrations apply lucid-queue --local && wrangler dev --port 8795",
